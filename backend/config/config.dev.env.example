# --- Server ---
PORT=8080

# --- PostgreSQL Database ---
DB_USER=user
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=booking_service

# --- JWT ---
JWT_SECRET=supersecretkey
JWT_EXPIRATION=120  # in seconds (1 hour)

# --- Email Sender (Gmail SMTP) ---
EMAIL_SENDER_FROM_ADDRESS=esports.booking.service@gmail.com
EMAIL_SENDER_SMTP_HOST=smtp.gmail.com
EMAIL_SENDER_SMTP_PORT=587
EMAIL_SENDER_APP_PASSWORD="your password"

# --- Allowed CORS Origins (divided through ,)---
ALLOWED_ORIGINS=http:http://localhost:3000