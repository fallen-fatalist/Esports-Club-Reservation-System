    "/api/bookings/active": {
      "get": {
        "summary": "Get active bookings",
        "description": "Returns a list of active bookings with time format \"2006-01-02T15:04:05Z07:00\"",
        "responses": {
          "200": {
            "description": "List of active bookings",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
