      }
    },
    "/api/computers/{id}/bookings": {
      "get": {
        "summary": "Get bookings for a specific computer",
        "description": "Returns a list of bookings for the specified computer ID with time format \"2006-01-02T15:04:05Z07:00\"",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Computer ID",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of bookings for the computer",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid computer ID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
