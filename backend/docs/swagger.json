    "/api/payment/deposit": {
      "post": {
        "summary": "Deposit money to user account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "user_id": {
                    "type": "integer"
                  },
                  "amount": {
                    "type": "number",
                    "format": "float"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deposit successful"
          }
        }
      }
    },
    "/api/payment/booking": {
      "post": {
        "summary": "Pay for a booking",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "computer_id": {
                    "type": "integer"
                  },
                  "end_time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "package_id": {
                    "type": "integer"
                  },
                  "start_time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "user_id": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment successful"
          }
        }
